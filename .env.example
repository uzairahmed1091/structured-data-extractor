# Shared demo key. Rate limited by IP; leave unset to force bring-your-own-key.
OPENAI_API_KEY=

# Site-wide ceiling on what the shared key may spend per UTC day, in USD. Defaults to 1.
# Per-IP limiting bounds one visitor; this bounds the bill. When it's reached the demo
# path closes for the day and the UI asks visitors for their own key.
DEMO_DAILY_BUDGET_USD=0.2

# Supabase — run persistence and the read-through cache.
# Must be the SECRET key (sb_secret_…). RLS on extraction_runs denies all client roles,
# so the publishable/anon key silently reads nothing and writes nothing.
# Server-only: never expose either of these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Upstash — IP rate limiting. Omit locally; falls back to an in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
